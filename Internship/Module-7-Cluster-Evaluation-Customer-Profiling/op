import pandas as pd
import numpy as np

df = pd.read_csv('/mnt/user-data/uploads/marketing_campaign.csv', sep='\t')
print("BEFORE cleaning:", df.shape)

# 1. Fill missing Income with median
median_income = df['Income'].median()
df['Income'] = df['Income'].fillna(median_income)
print(f"Filled 24 missing Income values with median: {median_income}")

# 2. Fix Marital_Status: merge Alone -> Single, remove Absurd/YOLO
df['Marital_Status'] = df['Marital_Status'].replace({'Alone': 'Single'})
before = len(df)
df = df[~df['Marital_Status'].isin(['Absurd', 'YOLO'])]
print(f"Removed {before - len(df)} rows with junk Marital_Status (Absurd/YOLO)")

# 3. Remove age outliers (Year_Birth < 1940)
before = len(df)
df = df[df['Year_Birth'] >= 1940]
print(f"Removed {before - len(df)} rows with unrealistic Year_Birth (<1940)")

# 4. Remove income outlier
before = len(df)
df = df[df['Income'] < 200000]
print(f"Removed {before - len(df)} rows with Income outlier (>200000)")

# 5. Drop constant columns
df = df.drop(columns=['Z_CostContact', 'Z_Revenue'])
print("Dropped Z_CostContact and Z_Revenue (constant columns)")

print("\nAFTER cleaning:", df.shape)
print("\nRemaining missing values:", df.isnull().sum().sum())
print("\nMarital_Status now:", df['Marital_Status'].value_counts().to_dict())

